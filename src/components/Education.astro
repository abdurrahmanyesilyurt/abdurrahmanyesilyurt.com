---
import Section from './Section.astro';
import { cv, formatDate, t, type Cefr } from '../data/cv';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  number: string;
}

const { lang, number } = Astro.props;
const s = ui[lang];

const cefrLevels: Cefr[] = ['A1', 'A2', 'B1', 'B2', 'C1', 'C2'];
const subheading = 'font-mono text-[11px] tracking-[0.14em] text-ink-2 uppercase';
---

<Section id={s.sections.education.id} number={number} title={s.sections.education.label} keepTogether>
  <div class="grid gap-x-10 gap-y-14 md:grid-cols-2 print:grid-cols-2 print:gap-y-5">
    {
      cv.education.length > 0 && (
        <div class="scroll-reveal">
          <h3 class={subheading}>{s.education}</h3>
          <ul class="mt-4 space-y-6 print:mt-2">
            {cv.education.map((edu) => (
              <li class="print-break-avoid">
                <p class="font-serif text-2xl leading-tight sm:text-[1.75rem] print:text-lg">{t(edu.school, lang)}</p>
                <p class="mt-1 text-ink-2">{t(edu.degree, lang)}</p>
                {(edu.start || edu.end) && (
                  <p class="mt-1 font-mono text-xs text-ink-2">
                    {[edu.start, edu.end]
                      .filter((d): d is string => Boolean(d))
                      .map((d) => formatDate(d, lang))
                      .join(' — ')}
                  </p>
                )}
                {edu.note && <p class="mt-3 text-sm leading-relaxed text-ink-2 print:mt-1.5 print:leading-snug">{t(edu.note, lang)}</p>}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      cv.certifications.length > 0 && (
        <div class="scroll-reveal">
          <h3 class={subheading}>{s.certifications}</h3>
          <ul class="mt-4 space-y-5 print:mt-2 print:space-y-2">
            {cv.certifications.map((cert) => (
              <li class="print-break-avoid">
                <p class="text-lg leading-snug">{t(cert.name, lang)}</p>
                {(cert.issuer || cert.date) && (
                  <p class="mt-0.5 text-sm text-ink-2">
                    {[cert.issuer && t(cert.issuer, lang), cert.date && formatDate(cert.date, lang)].filter(Boolean).join(' · ')}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      cv.languages.length > 0 && (
        <div class="scroll-reveal md:col-span-2 print:col-span-2">
          <h3 class={subheading}>{s.languages}</h3>
          <ul class="mt-4 divide-y divide-rule border-y border-rule print:mt-2">
            {cv.languages.map((language) => (
              <li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-4 print:py-2">
                <div>
                  <p class="font-serif text-2xl leading-none print:text-lg">{t(language.name, lang)}</p>
                  {language.note && <p class="mt-1.5 text-sm text-ink-2">{t(language.note, lang)}</p>}
                </div>
                {language.level === 'native' || language.level === 'basic' ? (
                  <p class="font-mono text-xs tracking-[0.14em] text-ink-2 uppercase">
                    {language.level === 'native' ? s.native : s.basic}
                  </p>
                ) : (
                  <div class="flex items-center gap-4">
                    <div class="flex gap-1" role="img" aria-label={`CEFR ${language.level}`}>
                      {cefrLevels.map((level, i) => (
                        <span
                          title={level}
                          class:list={[
                            'h-1.5 w-6 rounded-full sm:w-8',
                            i <= cefrLevels.indexOf(language.level as Cefr) ? 'bg-accent' : 'bg-rule',
                          ]}
                        />
                      ))}
                    </div>
                    <p class="font-mono text-xs tracking-[0.14em] text-ink-2 uppercase">{language.level}</p>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</Section>
