---
import { cv, formatDate } from '../data/cv';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = ui[lang];

const now = new Date();
const updated = formatDate(`${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`, lang);
---

<footer class="mx-auto max-w-[1180px] px-5 sm:px-8 lg:px-12 print:hidden">
  <div
    class="flex flex-col gap-3 border-t border-rule py-8 font-mono text-[11px] tracking-[0.12em] text-ink-3 uppercase sm:flex-row sm:items-center sm:justify-between"
  >
    <p>© {now.getFullYear()} <span lang="tr">{cv.name}</span></p>
    <p>{s.builtWith}</p>
    <p>{s.lastUpdated}: {updated}</p>
  </div>
</footer>
