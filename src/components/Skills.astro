---
import Section from './Section.astro';
import ExpandAll from './ExpandAll.astro';
import ToggleIcon from './ToggleIcon.astro';
import TechIcon from './TechIcon.astro';
import TechPool from './TechPool.astro';
import { cv, t, toSkillItem } from '../data/cv';
import { brandIcon } from '../lib/icons';
import { tint } from '../lib/tints';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  number: string;
}

const { lang, number } = Astro.props;
const s = ui[lang];

// Gruplar kapalı kartlar olarak listelenir; kapalıyken logolardan kısa bir önizleme görünür
// (önce ana odak olanlar). İlk grup (Backend) iki sütunu kaplar; her grup sıradaki renk tonunu alır.
const PREVIEW_ICONS = 6;
const groups = cv.skills.map((group, index) => {
  const items = group.items.map((raw) => {
    const item = toSkillItem(raw);
    return { label: t(item.label, lang), core: Boolean(item.core), icon: brandIcon(item.icon) };
  });
  const withIcon = [...items.filter((item) => item.icon && item.core), ...items.filter((item) => item.icon && !item.core)];
  // Aynı logoyu paylaşanlar (.NET, ASP.NET Core, EF Core…) önizlemede bir kez görünür
  const previewIcons = withIcon
    .filter((item, i) => withIcon.findIndex((other) => other.icon?.path === item.icon?.path) === i)
    .slice(0, PREVIEW_ICONS);
  // Logosu olmayan gruplarda önizleme yazıyla verilir
  const previewText = previewIcons.length === 0 ? items.slice(0, 3).map((item) => item.label) : [];
  return {
    name: t(group.name, lang),
    index: String(index + 1).padStart(2, '0'),
    wide: index === 0,
    tint: tint(index),
    items,
    previewIcons,
    previewText,
    more: items.length - (previewIcons.length || previewText.length),
  };
});

const hasCore = groups.some((group) => group.items.some((item) => item.core));
---

<Section id={s.sections.skills.id} number={number} title={s.sections.skills.label}>
  {
    hasCore && (
      <p
        slot="header-extra"
        class="mt-5 flex items-center gap-2 font-mono text-[11px] tracking-[0.12em] text-ink-2 uppercase print:hidden"
      >
        <span class="size-3 rounded-full border border-accent bg-accent/15" aria-hidden="true" />
        {s.coreLegend}
      </p>
    )
  }
  <ExpandAll slot="header-extra" lang={lang} />

  <TechPool lang={lang} />

  <ul class="grid items-start gap-3 md:grid-cols-2 print:grid-cols-2 print:gap-x-6 print:gap-y-0">
    {
      groups.map((group) => (
        <li class:list={['scroll-reveal print-break-avoid', group.wide && 'md:col-span-2 print:col-span-2']}>
          <details
            data-expandable
            class:list={[
              'group glow-card tile-tint rounded-2xl print:rounded-none print:border-0 print:border-b print:border-rule',
              group.tint,
            ]}
          >
            <summary class="group/summary grid cursor-pointer list-none grid-cols-[1fr_auto] items-center gap-x-4 gap-y-3 px-5 py-4 sm:px-6 sm:py-5 [&::-webkit-details-marker]:hidden print:px-0 print:py-2">
              <h3 class="col-start-1 row-start-1 flex items-baseline gap-3">
                <span class="font-mono text-[11px] text-ink-3">{group.index}</span>
                <span class="font-serif text-2xl leading-none transition-colors group-hover/summary:text-accent print:text-base">
                  {group.name}
                </span>
                <span class="font-mono text-[11px] text-ink-3" aria-hidden="true">
                  {group.items.length}
                </span>
              </h3>
              <ToggleIcon class="col-start-2 row-start-1" />

              {/* Kapalıyken önizleme; açılınca tam liste görünür */}
              <span aria-hidden="true" class="col-start-1 row-start-2 flex items-center gap-2.5 group-open:hidden print:hidden">
                {group.previewIcons.length > 0 ? (
                  <span class="flex -space-x-1.5">
                    {group.previewIcons.map((item) => (
                      <span class:list={['rounded-full ring-2', item.core ? 'ring-accent' : 'ring-(--tile-bg)']}>
                        {item.icon && <TechIcon icon={item.icon} class="block size-6" />}
                      </span>
                    ))}
                  </span>
                ) : (
                  <span class="text-[14px] text-ink-2">{group.previewText.join(' · ')}</span>
                )}
                {group.more > 0 && <span class="font-mono text-[11px] text-ink-3">+{group.more}</span>}
              </span>
            </summary>

            <ul class="flex flex-wrap gap-2 px-5 pb-6 sm:px-6 print:gap-x-3 print:gap-y-1 print:px-0 print:pb-2">
              {group.items.map((item) => (
                <li
                  class:list={[
                    'inline-flex items-center gap-2 rounded-full border py-1 pr-3.5 text-[14px] leading-6 transition-colors print:border-0 print:bg-transparent print:p-0 print:text-[10px] print:leading-4',
                    item.icon ? 'pl-1' : 'pl-3.5',
                    // Renkli kartın üstünde beyaz çipler; ana odak olanlar vurgu rengi çerçeveli
                    item.core
                      ? 'border-accent bg-paper font-medium text-ink'
                      : 'border-transparent bg-paper text-ink-2 hover:border-ink hover:text-ink',
                  ]}
                >
                  {item.icon && <TechIcon icon={item.icon} class="size-6 shrink-0 print:size-3" />}
                  {item.label}
                </li>
              ))}
            </ul>
          </details>
        </li>
      ))
    }
  </ul>
</Section>
