---
import Section from './Section.astro';
import { cv, displayUrl } from '../data/cv';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  number: string;
}

const { lang, number } = Astro.props;
const s = ui[lang];

interface ContactLink {
  label: string;
  href: string;
  text: string;
  // Marka adları Türkçe büyük harfe çevrilmesin diye (GitHub → "GİTHUB" olmasın)
  labelLang?: string;
}

const links = [
  cv.links.email && { label: s.contactLinks.email, href: `mailto:${cv.links.email}`, text: cv.links.email },
  cv.links.github && {
    label: s.contactLinks.github,
    href: cv.links.github,
    text: displayUrl(cv.links.github),
    labelLang: 'en',
  },
  cv.links.linkedin && {
    label: s.contactLinks.linkedin,
    href: cv.links.linkedin,
    text: displayUrl(cv.links.linkedin),
    labelLang: 'en',
  },
].filter((link): link is ContactLink => Boolean(link));
---

<!-- Baskıda iletişim bilgileri en üstte, ismin altında (Hero) yer alır -->
<div class="print:hidden">
  <Section id={s.sections.contact.id} number={number} title={s.sections.contact.label}>
    <p class="scroll-reveal font-serif text-[clamp(2.5rem,6vw,4.75rem)] leading-[0.98] tracking-[-0.015em] text-balance">
      {s.contactTitle} <em class="text-accent">{s.contactAccent}</em>
    </p>

    <ul class="mt-12 divide-y divide-rule border-y border-rule">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener' : undefined}
              class="group flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-5"
            >
              <span lang={link.labelLang} class="font-mono text-[11px] tracking-[0.14em] text-ink-2 uppercase">
                {link.label}
              </span>
              <span class="text-xl transition-colors group-hover:text-accent sm:text-2xl">
                {link.text}
                <span
                  aria-hidden="true"
                  class="inline-block transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                >
                  ↗
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Section>
</div>
