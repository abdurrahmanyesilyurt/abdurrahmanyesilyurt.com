---
import { formatPostDate, postUrl, readingMinutes, type Post } from '../lib/posts';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  posts: Post[];
  lang: Lang;
  headingLevel?: 'h2' | 'h3';
}

const { posts, lang, headingLevel = 'h3' } = Astro.props;
const s = ui[lang];
const Heading = headingLevel;
---

<ul class="divide-y divide-rule border-y border-rule">
  {
    posts.map((post) => (
      <li class="scroll-reveal">
        <a href={postUrl(post)} class="group grid gap-x-8 gap-y-2 py-7 sm:grid-cols-[10.5rem_1fr]">
          <div class="pt-2 font-mono text-xs tracking-[0.1em] text-ink-2 uppercase">
            <time datetime={post.data.date.toISOString().slice(0, 10)}>{formatPostDate(post.data.date, lang)}</time>
          </div>
          <div>
            <Heading class="font-serif text-[1.75rem] leading-tight text-balance transition-colors group-hover:text-accent sm:text-[2rem]">
              {post.data.title}
            </Heading>
            <p class="mt-2 leading-relaxed text-ink-2">{post.data.description}</p>
            <p class="mt-3 font-mono text-[11px] tracking-[0.08em] text-ink-2 uppercase">
              {s.blog.readingTime(readingMinutes(post))}
              {post.data.tags.map((tag) => (
                <span> · #{tag}</span>
              ))}
            </p>
          </div>
        </a>
      </li>
    ))
  }
</ul>
