---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import ExpandAll from './ExpandAll.astro';
import ToggleIcon from './ToggleIcon.astro';
import QrCode from './QrCode.astro';
import { cv, displayUrl, t } from '../data/cv';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  number: string;
}

const { lang, number } = Astro.props;
const s = ui[lang];
const locale = lang === 'tr' ? 'tr-TR' : 'en-US';

// İkonu olmayan projeler için kısaltma: "mevzuat-rag" → "MR", "SeatFlow" → "SF"
const monogram = (name: string) =>
  name
    .replace(/(\p{Ll})(\p{Lu})/gu, '$1 $2')
    .split(/[\s\-_.]+/)
    .filter(Boolean)
    .slice(0, 2)
    .map((word) => word[0].toLocaleUpperCase(locale))
    .join('');

// Projeler kapalı, küçük kartlar olarak listelenir; tıklanınca kart yerinde açılır.
// Baskıda public/site.js hepsini açar.
const projects = cv.projects.map((project) => ({
  project,
  monogram: project.icon ? undefined : monogram(project.name),
  platforms: project.platforms && project.platforms.length > 0 ? project.platforms.join(' + ') : undefined,
  links: (project.links ?? []).map((link) => ({
    href: link.url,
    label: link.label ? t(link.label, lang) : s.projectLinks[link.type],
    // Baskıda linkler tıklanamadığı için adresin kendisi yazılır. Şablonda "wrap-anywhere": uzun GitHub
    // adresi bölünmezse dar kartta QR kodunu kart dışına iter.
    printText: link.type === 'web' || link.type === 'source' ? displayUrl(link.url) : s.projectLinks[link.type],
  })),
}));
---

<Section id={s.sections.projects.id} number={number} title={s.sections.projects.label}>
  <ExpandAll slot="header-extra" lang={lang} />

  <ul class="grid items-start gap-3 sm:grid-cols-2 print:grid-cols-2 print:gap-x-6 print:gap-y-0">
    {
      projects.map(({ project, monogram, platforms, links }) => (
        <li class="scroll-reveal print-break-avoid">
          <details
            data-expandable
            class:list={[
              'group rounded-2xl border bg-paper transition-colors print:rounded-none print:border-0 print:border-b print:border-rule',
              // Öne çıkan projeler, "ana odak" yetenekleri gibi yeşil çerçeveyle vurgulanır
              project.featured ? 'border-accent/45 hover:border-accent' : 'border-rule hover:border-ink/40 open:border-ink/30',
            ]}
          >
            <summary class="group/summary grid cursor-pointer list-none grid-cols-[auto_1fr_auto] items-center gap-x-4 p-4 sm:p-5 [&::-webkit-details-marker]:hidden print:gap-x-3 print:px-0 print:py-2">
              {project.icon ? (
                <Image
                  src={project.icon}
                  alt=""
                  width={96}
                  height={96}
                  class="col-start-1 row-span-2 row-start-1 size-12 rounded-xl ring-1 ring-rule print:size-8"
                />
              ) : (
                <span
                  aria-hidden="true"
                  class="col-start-1 row-span-2 row-start-1 grid size-12 place-items-center rounded-xl bg-accent/10 font-mono text-sm font-medium tracking-wider text-accent ring-1 ring-accent/30 print:size-8 print:text-[10px]"
                >
                  {monogram}
                </span>
              )}
              <h3 class="col-start-2 row-start-1 self-end font-serif text-2xl leading-tight transition-colors group-hover/summary:text-accent print:text-base">
                {project.name}
              </h3>
              <span class="col-start-2 row-start-2 mt-0.5 self-start font-mono text-[10.5px] leading-snug tracking-[0.1em] text-ink-2 uppercase print:text-[8.5px]">
                {t(project.category, lang)}
                {platforms && (
                  <>
                    <span aria-hidden="true">{' · '}</span>
                    {/* Marka adları: Türkçe büyük harf kuralı "iOS"u "İOS" yapmasın */}
                    <span lang="en">{platforms}</span>
                  </>
                )}
              </span>
              <ToggleIcon class="col-start-3 row-span-2 row-start-1" />
            </summary>

            <div class="flex flex-col gap-4 px-4 pb-5 sm:px-5 sm:pb-6 print:gap-1.5 print:px-0 print:pb-3">
              <p class="leading-relaxed text-ink-2 print:text-sm print:leading-snug">{t(project.description, lang)}</p>

              {project.role && (
                <p class="text-[15px] leading-relaxed print:text-sm print:leading-snug">
                  <span class="mr-2 font-mono text-[11px] tracking-[0.1em] text-ink-2 uppercase print:text-[9px]">{s.projectRole}</span>
                  {t(project.role, lang)}
                </p>
              )}

              <ul lang="en" class="flex flex-wrap gap-x-3 gap-y-1 font-mono text-[11px] tracking-[0.08em] text-ink-2 uppercase print:gap-x-2 print:gap-y-0 print:text-[9px]">
                {project.tech.map((tech) => (
                  <li>{tech}</li>
                ))}
              </ul>

              {(links.length > 0 || project.qr) && (
                <div class="flex items-end justify-between gap-4">
                  {links.length > 0 && (
                    <div class="flex flex-wrap gap-2 print:hidden">
                      {links.map((link) => (
                        <a
                          href={link.href}
                          target="_blank"
                          rel="noopener"
                          class="inline-flex items-center gap-1.5 rounded-full border border-rule px-3.5 py-1.5 text-[13px] transition-colors hover:border-ink hover:text-accent"
                        >
                          {link.label} <span aria-hidden="true">↗</span>
                        </a>
                      ))}
                    </div>
                  )}
                  {links.length > 0 && (
                    <p class="hidden min-w-0 font-mono text-[9px] wrap-anywhere text-ink-2 print:block">
                      {links.map((link) => link.printText).join(' · ')}
                    </p>
                  )}
                  {project.qr && (
                    <figure class="ml-auto hidden w-20 shrink-0 text-center sm:block print:block print:w-16">
                      <QrCode
                        value={project.qr.url}
                        label={`${project.name} — ${t(project.qr.label, lang)}`}
                        class="block w-full rounded-md border border-rule"
                      />
                      <figcaption class="mt-1.5 font-mono text-[10px] leading-tight text-ink-2 print:mt-1 print:text-[8px]">
                        {t(project.qr.label, lang)}
                      </figcaption>
                    </figure>
                  )}
                </div>
              )}
            </div>
          </details>
        </li>
      ))
    }
  </ul>
</Section>
