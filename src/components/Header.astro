---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { cv } from '../data/cv';
import { languages, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  nav: { href: string; label: string }[];
  /** İsme tıklanınca gidilecek adres: ana sayfada "#top", diğer sayfalarda ana sayfa */
  homeHref?: string;
  /** Dil düğmelerinin adresleri (varsayılan: her dilin ana sayfası) */
  langHrefs?: Partial<Record<Lang, string>>;
}

const { lang, nav, homeHref = '#top', langHrefs = {} } = Astro.props;
const s = ui[lang];
const codes = Object.keys(languages) as Lang[];
---

<header class="sticky top-0 z-40 border-b border-rule bg-paper/85 backdrop-blur-md print:hidden">
  <div class="mx-auto flex h-16 max-w-[1180px] items-center justify-between gap-6 px-5 sm:px-8 lg:px-12">
    <a href={homeHref} class="font-serif text-xl leading-none tracking-tight whitespace-nowrap">
      {cv.name}<span class="text-accent">.</span>
    </a>

    <nav aria-label={s.navLabel} class="hidden md:block">
      <ul class="flex items-center gap-7 font-mono text-[11px] tracking-[0.14em] text-ink-2 uppercase">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-0.5">
      <div class="mr-1 flex items-center font-mono text-[11px] tracking-[0.14em] uppercase">
        {
          codes.map((code) =>
            code === lang ? (
              <span class="px-1.5 py-1 text-ink" aria-current="page">
                {code}
              </span>
            ) : (
              <a
                href={langHrefs[code] ?? getRelativeLocaleUrl(code)}
                hreflang={code}
                lang={code}
                title={languages[code]}
                class="px-1.5 py-1 text-ink-3 transition-colors hover:text-ink"
              >
                {code}
              </a>
            ),
          )
        }
      </div>
      <button
        type="button"
        data-theme-toggle
        aria-label={s.themeToggle}
        title={s.themeToggle}
        class="grid size-9 cursor-pointer place-items-center rounded-full text-ink-2 transition-colors hover:bg-ink/5 hover:text-ink"
      >
        <svg viewBox="0 0 24 24" class="size-[18px]" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <circle cx="12" cy="12" r="8.25"></circle>
          <path d="M12 3.75a8.25 8.25 0 0 1 0 16.5z" fill="currentColor" stroke="none"></path>
        </svg>
      </button>
      <button
        type="button"
        data-print
        aria-label={s.savePdf}
        title={s.savePdf}
        class="grid size-9 cursor-pointer place-items-center rounded-full text-ink-2 transition-colors hover:bg-ink/5 hover:text-ink"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-[18px]"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 4v11m0 0-4.25-4.25M12 15l4.25-4.25M5 19.5h14"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Tema ve PDF düğmelerinin tıklamaları public/site.js içinde dinleniyor -->
