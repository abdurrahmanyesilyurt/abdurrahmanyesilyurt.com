---
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/instrument-sans/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

import serifLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifItalicLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import sansLatin from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternates?: { lang: Lang; href: string }[];
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** Blog yazıları için Open Graph "article" bilgileri */
  article?: { publishedTime: Date; modifiedTime?: Date; tags?: string[] };
  /** Paylaşım görseli (varsayılan: dilin ana sayfa kartı, build'de üretilir) */
  ogImage?: string;
  ogImageAlt?: string;
}

const {
  lang,
  title,
  description,
  alternates = [],
  jsonLd,
  noindex = false,
  article,
  ogImage: ogImagePath = `/og/${lang}.png`,
  ogImageAlt = 'Abdurrahman Yeşilyurt',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(ogImagePath, Astro.site);
// x-default: varsayılan dil (Türkçe) sürümü
const xDefault = alternates.find((alt) => alt.lang === 'tr')?.href ?? '/';
const rssHref = `${lang === 'tr' ? '' : '/en'}/rss.xml`;

// Hero'da görünen fontlar ilk boyamadan önce insin
const preloadFonts = [serifLatin, serifItalicLatin, sansLatin];

// JSON-LD içinde "</script>" gibi bir dizi etiketi kapatamasın
const jsonLdHtml = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={new URL(alt.href, Astro.site)} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL(xDefault, Astro.site)} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="alternate" type="application/rss+xml" title={ui[lang].blog.title} href={rssHref} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f100e" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content={article ? 'article' : 'profile'} />
    {article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
    {article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}
    {article?.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta property="og:site_name" content="Abdurrahman Yeşilyurt" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}

    <!-- Kaydedilmiş temayı sayfa boyanmadan önce uygular; CSP gereği harici dosya -->
    <script is:inline src="/site.js"></script>

    <!-- Vercel Web Analytics: çerezsiz, kendi alan adından yüklenir (CSP: script-src 'self') -->
    {import.meta.env.PROD && <script is:inline defer src="/_vercel/insights/script.js"></script>}

    {jsonLdHtml && <script is:inline type="application/ld+json" set:html={jsonLdHtml} />}
  </head>
  <body class="min-h-dvh">
    <slot />
  </body>
</html>
